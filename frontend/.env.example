# URL de la API backend
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Otras variables de entorno
NEXT_PUBLIC_APP_NAME=SERSA

# NEXT_PUBLIC_APP_VERSION y NEXT_PUBLIC_BUILD_TIME no se configuran acá:
# next.config.js las genera automáticamente en cada build (la primera desde
# el campo "version" de frontend/package.json, la segunda con
# new Date().toISOString()) y se muestran en el login para saber qué versión
# quedó desplegada.