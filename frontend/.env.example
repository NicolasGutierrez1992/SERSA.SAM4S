# URL de la API backend
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Otras variables de entorno
NEXT_PUBLIC_APP_NAME=SERSA
NEXT_PUBLIC_APP_VERSION=1.0.0

# NEXT_PUBLIC_BUILD_TIME no se configura acá: next.config.js lo genera
# automáticamente en cada build (new Date().toISOString()) y se muestra en el
# login para saber qué versión quedó desplegada.